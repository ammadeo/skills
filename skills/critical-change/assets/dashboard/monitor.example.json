{
  "change": "../example.json",
  "port": 4173,
  "checks": [
    {
      "id": "S1",
      "label": "Someone signed in before the change is still signed in",
      "kind": "ping",
      "cmd": "scripts/smoke.sh existing-session",
      "critical": true,
      "covers": [
        "R1"
      ],
      "every": 10
    },
    {
      "id": "S2",
      "label": "A new login works and survives the next request",
      "kind": "ping",
      "cmd": "scripts/smoke.sh fresh-login",
      "on_demand": true,
      "critical": true,
      "covers": [
        "R1",
        "U2"
      ]
    },
    {
      "id": "S4",
      "label": "Pages are as fast as before",
      "kind": "ping",
      "cmd": "scripts/smoke.sh latency",
      "critical": false,
      "covers": [
        "R3"
      ],
      "every": 15
    }
  ]
}
